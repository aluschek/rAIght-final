{
  "name": "raight",
  "version": "0.1.0",
  "description": "rAIght – SAP CAP backend: serves the app/ pages and computes the monitor metrics from run logs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "watch": "cds watch",
    "start": "cds-serve",
    "test": "node --test"
  },
  "dependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "[production]": {
        "auth": "dummy"
      }
    },
    "features": {
      "in_memory_db": true
    },
    "fiori": {
      "preview": true
    }
  }
}
